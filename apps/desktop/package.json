{
  "name": "@modus/desktop",
  "version": "0.1.2",
  "description": "Local-first Modus desktop agent window.",
  "author": "Modus contributors",
  "homepage": "https://github.com/Stoltembergg/modus",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:pty && electron-vite build",
    "build:pty": "cargo build --release -p modus-pty-host",
    "preview": "electron-vite preview",
    "prepare:fast-codebase": "node scripts/prepare-fast-codebase.mjs",
    "package": "npm run prepare:fast-codebase && electron-builder --config electron-builder.config.ts",
    "package:mac": "npm run prepare:fast-codebase && electron-builder --mac --config electron-builder.config.ts",
    "package:win": "npm run prepare:fast-codebase && electron-builder --win --config electron-builder.config.ts",
    "package:linux": "npm run prepare:fast-codebase && electron-builder --linux --config electron-builder.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. apps/desktop/src apps/desktop/scripts",
    "check:case": "vitest run --root ../.. apps/desktop/scripts/case-collisions"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.1.1",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.5",
    "js-yaml": "^5.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@base-ui/react": "^1.5.0",
    "@composio/core": "^0.22.0",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pierre/diffs": "^1.5.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-virtual": "3.14.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "docx-preview": "^0.4.0",
    "electron-updater": "6.8.9",
    "exceljs": "^4.4.0",
    "katex": "^0.19.0",
    "material-icon-theme": "^5.36.1",
    "monaco-editor": "^0.57.0",
    "motion": "^14.0.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-breaks": "4.0.0",
    "streamdown": "^2.5.0",
    "thinking-orbs": "^0.3.2",
    "turndown": "^7.2.4",
    "typebox": "1.3.34",
    "zod": "^4.4.3"
  }
}
