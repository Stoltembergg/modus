# Edge Function secrets (supabase/functions). Copy to supabase/functions/.env for
# `supabase functions serve`; in the hosted project set them with
# `supabase secrets set KEY=value` (never commit real values).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_DB_URL are provided by the runtime.

# --- Stripe (test mode only: every Stripe Function refuses to boot without sk_test_) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# L1b: Stripe checkout / Customer Portal switch. Only the exact value "true" enables them.
# Missing, empty or anything else = DISABLED (fail closed). When disabled:
#   create-checkout-session -> 503 {"error":"stripe_disabled"} for everyone;
#   create-portal-session   -> opens only for a user with a Stripe subscription row in
#                              active / trialing / past_due / unpaid, 503 for everyone else;
#   stripe-webhook          -> not gated, keeps processing events.
# Release L1 sells through Mercado Pago only: leave false (or unset) in production.
STRIPE_ENABLED=false

# --- Billing return page (https; http only for localhost) ---
BILLING_RETURN_URL=https://modus.example/billing/return

# --- Mercado Pago (B6a) ---
MP_ACCESS_TOKEN=TEST-replace-me
MP_WEBHOOK_SECRET=replace_me_16_chars_min
MP_COLLECTOR_ID=0

# --- model-router (B4a) ---
MODUS_UPSTREAM_KEY_CLAUDE=
MODUS_UPSTREAM_KEY_CHINA=
MODUS_UPSTREAM_KEY_CODEX_PLUS=
MODUS_UPSTREAM_KEY_CODEX_PRO=
# Optional (defaults in model-router/config.ts)
# MODUS_UPSTREAM_BASE_URL=https://vibi.top/v1
# MODUS_ROUTER_MAX_DURATION_MS=120000
# CREDIT_MARKUP=
